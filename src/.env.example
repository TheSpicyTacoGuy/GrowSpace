# Copy this file to src/.env and fill in your Firebase project's web app
# credentials. Vite loads it from src/ because that is the Vite root.
#
# Leave these blank to run GrowSpace in demo mode: the app boots with an
# in-memory sample backend (see src/js/demo) so you can click around and take
# screenshots without a Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=